{
  "name": "flor-de-lotus",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/prepare-public.mjs",
    "prebuild": "node scripts/prepare-public.mjs",
    "test": "python3 -m unittest discover -s tests -v",
    "dev:api": "HOST=127.0.0.1 python3 server.py",
    "test:next": "python3 scripts/test-next.py",
    "test:supabase-api": "node scripts/test-supabase-next.mjs",
    "test:guest-auth": "node scripts/test-guest-auth-next.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "cheerio": "1.1.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
